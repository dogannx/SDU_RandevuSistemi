# docker-compose için ortam değişkenleri.
# Bu dosyayı `.env` olarak kopyala ve değerleri doldur.

# PostgreSQL
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=randevu_db

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# JWT
JWT_SECRET=randevu-jwt-secret-key-2026
JWT_REFRESH_SECRET=randevu-jwt-refresh-secret-key-2026
